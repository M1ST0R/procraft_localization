{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M1ST0R/procraft_localization/blob/main/schemas/community-translation-index.schema.json",
  "title": "ProCraft Community Translation Hub Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "updated_at",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "packs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "locale",
          "name",
          "author",
          "description",
          "version",
          "catalog_version",
          "strings_count",
          "updated_at",
          "download_url",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
          },
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[A-Za-z]{2,8}([_-][A-Za-z0-9]{2,8})*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "author": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "catalog_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "strings_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          },
          "updated_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://raw\\.githubusercontent\\.com/M1ST0R/procraft_localization/main/community-translations/[a-z0-9._-]+\\.procraft-lang$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
