{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M1ST0R/procraft_localization/blob/main/schemas/procraft-language-pack.schema.json",
  "title": "ProCraft Community Language Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "locale",
    "name",
    "strings"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}([_-][A-Za-z0-9]{2,8})*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "app_version": {
      "type": "string",
      "maxLength": 40
    },
    "catalog_version": {
      "type": "string",
      "maxLength": 80
    },
    "base_locale": {
      "type": "string",
      "maxLength": 35,
      "default": "en"
    },
    "strings": {
      "type": "object",
      "maxProperties": 20000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    }
  }
}
